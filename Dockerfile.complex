# syntax=docker/dockerfile:1

# Example only: replace this stage with the steps that assemble your payload.
# Use a supported, pinned base appropriate for your target architectures.
FROM alpine:3.23 AS buildstage

RUN mkdir -p /root-layer/defaults && \
    printf '%s\n' 'Generated during the build stage' > /root-layer/defaults/mod-build-example.txt

COPY root/ /root-layer/

# The distributed Mod must have exactly one filesystem layer.
FROM scratch

LABEL maintainer="username"

COPY --from=buildstage /root-layer/ /
